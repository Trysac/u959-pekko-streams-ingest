# Factory-owned file: agents must not edit it. Layout of this repository; scalafmt
# (.scalafmt.conf) applies and checks the Scala and sbt files.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
